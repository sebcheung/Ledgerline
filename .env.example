DATABASE_URL=postgresql+asyncpg://ledgerline:ledgerline@localhost:5432/ledgerline
LOG_LEVEL=INFO
ENVIRONMENT=development

IDEMPOTENCY_LOCK_TTL_SECONDS=30
RECON_WINDOW_DAYS=7
RECON_CUTOFF_LAG_HOURS=24
RECON_AUTO_RESOLVE_THRESHOLD_MINOR=500
RECON_FUZZY_DAYS=2
RECON_RUN_LOCK_TTL_SECONDS=300

WEBHOOK_POLL_INTERVAL_SECONDS=1.0
WEBHOOK_BATCH_SIZE=100
WEBHOOK_FANOUT_BATCH_SIZE=500
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BASE_DELAY_SECONDS=1.0
WEBHOOK_MAX_DELAY_SECONDS=3600.0
WEBHOOK_CONCURRENCY=10
WEBHOOK_STALE_CLAIM_SECONDS=60
WEBHOOK_CONNECT_TIMEOUT_SECONDS=5.0
WEBHOOK_READ_TIMEOUT_SECONDS=5.0

DASHBOARD_ENABLED=true
DASHBOARD_SSE_INTERVAL_SECONDS=2.0
DASHBOARD_SSE_KEEPALIVE_SECONDS=15.0
DASHBOARD_SSE_MAX_STREAM_SECONDS=3600.0
DASHBOARD_RECENT_TRANSACTIONS_LIMIT=25
DASHBOARD_RECENT_RUNS_LIMIT=10
DASHBOARD_QUEUE_LIMIT=50

# The demo scenario writes real ledger rows and registers webhook endpoints
# pointed at deliberately failing URLs -- off by default.
DEMO_ENABLED=false
DEMO_RETRY_ENDPOINT_URL=http://127.0.0.1:9/hook
DEMO_SELF_BASE_URL=http://127.0.0.1:8000

# API key cache TTL: 0 disables the cache, forcing every request to hit the
# database -- useful for immediate revocation. No auth_enabled flag exists;
# see docs/DECISIONS.md Phase 7 for why.
API_KEY_CACHE_TTL_SECONDS=30.0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100.0
RATE_LIMIT_BURST=200.0

METRICS_ENABLED=true

IDEMPOTENCY_RETENTION_DAYS=30
